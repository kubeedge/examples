    "version": "0.2.0",
    "configurations": [
        {
            "name": "me-restful",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/cmd/main.go",
            "cwd": "${workspaceFolder}",
            "asRoot": true,
            "console": "integratedTerminal",
            "env": {
                "PATH": "${env:PATH}:/home/osboxes/.goenv/versions/1.22.12", // in case your go sdk is only in PATH of normal user, not root
                "CGO_ENABLED": "1",
            }
        }
    ]
}